---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Tema Werkstatt: migas, taller del servicio en letra menuda, título en mayúsculas de Jost, texto corto, precio en una
// celda con filetes y botones (presupuesto y llamar); a la derecha, la foto enmarcada en blanco y negro con el pie del
// color de su taller. Debajo, el `detalle` en párrafos y, al lado, los datos en filas y la caja de tinta para pedir
// presupuesto; las fotos (`imagenes`) enmarcadas y otros servicios de la misma lista como índice con filetes.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Banda from '../../components/ui/Banda.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp, letras, colorDe } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const presupuesto = seccion('presupuesto') ? enlace('/#presupuesto') : site.boton_cabecera?.url || enlace('/#contacto');
const textoPresupuesto = site.boton_cabecera?.texto || 'Pedir presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero presupuesto de ${f.titulo.toLowerCase()}`);
const otras = relacionadas(f, 4);
const descripcion = resumen(f.texto || f.detalle[0] || '');
const n = colorDe(f.categoria);
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'categoria');
const muestra = (cat?: string) => {
  const k = colorDe(cat);
  return k > 0 ? `muestra cat-${k}` : 'muestra';
};
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="portada">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-cabeza', { 'ficha-cabeza--foto': f.imagen }]}>
        <div class="ajuste">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="ficha-titulo encaja" style={`--letras:${letras(f.titulo)}`}>{f.titulo}</h1>
          {f.texto && <p class="portada-parrafo">{f.texto}</p>}
          {f.precio && (
            <ul class="ficha-precio celdas">
              <li><span class="portada-dato">{f.precio}</span></li>
            </ul>
          )}
          <div class="botones">
            <a class="btn" href={presupuesto}>{textoPresupuesto}</a>
            {c.telefono && <a class="btn-sec" href={tel(c.telefono)}>Llamar al {c.telefono}</a>}
          </div>
        </div>
        {f.imagen && (
          <figure class="pieza marco">
            <div class="foto">
              <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad />
            </div>
            {f.categoria && (
              <ul class="franja" style="--n:1">
                <li class={n > 0 ? `relleno cat-${n} ajuste` : 'relleno ajuste'}><span class="encaja" style={`--letras:${letras(f.categoria)}`}>{f.categoria}</span></li>
              </ul>
            )}
          </figure>
        )}
      </div>
    </div>
  </section>

  <Banda color="papel2">
    <div class="ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {datos.length > 0 && (
          <dl class="ficha-datos">
            {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
          </dl>
        )}
        <div class="caja-tinta">
          <p class="caja-titulo">Medición sin compromiso</p>
          <p>Vamos a verlo, medimos y te damos el precio cerrado por escrito.</p>
          <a class="btn" href={presupuesto}>{textoPresupuesto}</a>
          {wa && <a class="enlace" href={wa} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>}
        </div>
      </aside>
    </div>
  </Banda>

  {f.imagenes.length > 0 && (
    <Banda color="papel" etiqueta={`Fotos de ${f.titulo}`}>
      <ul class="galeria-ficha">
        {f.imagenes.map((src, i) => (
          <li class="foto foto--color marco"><Imagen src={src} alt={`${f.titulo}, foto ${i + 2}`} ancho={1000} alto={750} /></li>
        ))}
      </ul>
    </Banda>
  )}

  {otras.length > 0 && (
    <Banda color="papel">
      <Titular antetitulo={nombreSeccion} titulo={`Otros ${f.def.nombre.toLowerCase()}s`} />
      <ul class="indice">
        {otras.map((o) => (
          <li class="indice-fila">
            <h3 class="indice-titulo encaja" style={`--letras:${letras(o.titulo)}`}><a href={o.url}>{o.titulo}</a></h3>
            <p class="indice-texto">{o.texto}</p>
            <p class="indice-cat">
              {o.categoria && <span class={muestra(o.categoria)} aria-hidden="true" />}
              {o.categoria}
            </p>
            <p class="indice-precio">{o.precio}</p>
          </li>
        ))}
      </ul>
    </Banda>
  )}
</Base>
