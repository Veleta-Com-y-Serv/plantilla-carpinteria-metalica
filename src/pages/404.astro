---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda banda--papel">
    <div class="contenedor">
      <p class="antetitulo">Error 404</p>
      <p class="error-cifra" aria-hidden="true">404</p>
      <h1 class="titulo-seccion" style="font-size:var(--tam);margin-top:2rem">Esta página no está en el taller</h1>
      <p class="entrada" style="margin-top:1rem">Puede que el enlace esté mal o que la página se haya movido.</p>
      <p class="botones"><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>
